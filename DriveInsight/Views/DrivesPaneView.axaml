<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:liveCharts="using:LiveChartsCore"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:paint="using:LiveChartsCore.SkiaSharpView.Painting"
             xmlns:paneControls="using:DriveInsight.Views.Controls"
             xmlns:icons="using:DriveInsight.Utilities"
             xmlns:viewModels="using:DriveInsight.ViewModels"
             xmlns:skia="clr-namespace:SkiaSharp;assembly=SkiaSharp"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="760"
             x:Class="DriveInsight.Views.DrivesPaneView">

    <Grid RowDefinitions="Auto,*"
          RowSpacing="0">
        <paneControls:HeaderPane Grid.Row="0"
                                 Title="Drives"
                                 ShowExportButton="True"
                                 ExportToolTip="Export CSV"
                                 ExportCommand="{Binding ExportCsvCommand}"
                                 ShowRefreshButton="True"
                                 RefreshToolTip="Refresh"
                                 RefreshCommand="{Binding RefreshAllCommand}">
            <paneControls:HeaderPane.CenterContent>
                <ListBox Classes="DriveTabs" x:Name="DriveTabs"
                         ItemsSource="{Binding Drives}"
                         SelectedItem="{Binding SelectedDrive}"
                         Padding="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name, StringFormat=Drive {0}}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </paneControls:HeaderPane.CenterContent>
            <paneControls:HeaderPane.RightContent>
                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" MaxWidth="150" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" Foreground="{DynamicResource AppSecondaryTextBrush}" VerticalAlignment="Center" />
                    <Button x:Name="DeepScanDriveButton"
                            ToolTip.Tip="Scan protected folders with administrator access"
                            Command="{Binding DeepScanSelectedDriveCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <paneControls:AppIcon Data="{x:Static icons:AppIcons.Shield}" Width="15" Height="15" />
                            <TextBlock Text="Deep scan" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ScanDriveButton" Classes="Primary"
                            Command="{Binding ScanSelectedDriveCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <paneControls:AppIcon Data="{x:Static icons:AppIcons.Search}" Width="15" Height="15" />
                            <TextBlock Text="Run scan" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </paneControls:HeaderPane.RightContent>
        </paneControls:HeaderPane>

        <Grid Grid.Row="1"
              Margin="24,24,24,24"
              RowDefinitions="Auto,*"
              RowSpacing="14">
            <Border Grid.Row="0"
                    Classes="SectionCard">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="24">
                    <Grid Width="184"
                          Height="184">
                        <lvc:PieChart Width="184"
                                      Height="184"
                                      InitialRotation="-90"
                                      MinValue="0"
                                      MaxValue="100"
                                      LegendPosition="Hidden">
                            <lvc:PieChart.Series>
                                <lvc:XamlGaugeSeries GaugeValue="{Binding UsedPercentage}"
                                                     DataLabelsSize="0"
                                                     MaxRadialColumnWidth="12">
                                    <lvc:XamlGaugeSeries.Fill>
                                        <paint:SolidColorPaint>
                                            <paint:SolidColorPaint.Color>
                                                <skia:SKColor>#275CE4</skia:SKColor>
                                            </paint:SolidColorPaint.Color>
                                        </paint:SolidColorPaint>
                                    </lvc:XamlGaugeSeries.Fill>
                                </lvc:XamlGaugeSeries>
                                <lvc:XamlGaugeBackgroundSeries MaxRadialColumnWidth="12" />
                            </lvc:PieChart.Series>
                        </lvc:PieChart>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                            <TextBlock Text="{Binding UsedPercentageText}"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="USED"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="1"
                          ColumnDefinitions="*,*,*"
                          ColumnSpacing="22"
                          VerticalAlignment="Center">
                        <StackPanel Spacing="4">
                            <TextBlock Text="TOTAL CAPACITY"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppMutedTextBrush}" />
                            <TextBlock Text="{Binding TotalCapacityText}"
                                       FontSize="28"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="4">
                            <TextBlock Text="USED SPACE"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppAccentBrush}" />
                            <TextBlock Text="{Binding UsedSpaceText}"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Spacing="4">
                            <TextBlock Text="AVAILABLE SPACE"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppMutedTextBrush}" />
                            <TextBlock Text="{Binding AvailableSpaceText}"
                                       FontSize="24"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <TreeDataGrid Grid.Row="1"
                          x:Name="FoldersGrid"
                          Margin="0"
                          Source="{Binding FolderRowsSource}" />
        </Grid>
    </Grid>
</UserControl>
