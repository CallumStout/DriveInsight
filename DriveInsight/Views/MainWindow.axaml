<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:DriveInsight.Views"
        x:Class="DriveInsight.Views.MainWindow"
        Title="DriveInsight" Width="1280" Height="820"
        MinWidth="1100" MinHeight="700" UseLayoutRounding="True" Icon="/Assets/App.ico">
    <Grid ColumnDefinitions="228,*">
        <Border Background="{DynamicResource AppSidebarBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto" Margin="16,24,16,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,0">
                        <Image Source="/Assets/AppLogo.png" Width="34" Height="34" Stretch="Uniform" />
                        <TextBlock Text="DriveInsight" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="STORAGE OVERVIEW" FontSize="10" LetterSpacing="1.2"
                               Foreground="{DynamicResource AppMutedTextBrush}" Margin="12,36,0,12" />
                    <ItemsControl ItemsSource="{Binding Panes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:PaneRadioButton Text="{Binding Title}" IconData="{Binding IconPathData}"
                                    IsChecked="{Binding IsActive}"
                                    Command="{Binding $parent[ItemsControl].DataContext.SelectPaneCommand}"
                                    CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Border Grid.Row="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="8,16,8,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="A clearer picture." FontSize="11" Foreground="{DynamicResource AppMutedTextBrush}" />
                        <TextBlock Grid.Column="1" Text="v1.2" FontSize="11" Foreground="{DynamicResource AppMutedTextBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource AppWindowBackgroundBrush}">
            <Grid x:Name="PaneHost" />
        </Border>
    </Grid>
</Window>
