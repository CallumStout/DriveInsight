<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DriveInsight.Views.Controls"
             x:Class="DriveInsight.Views.PaneRadioButton" x:Name="Root">
    <UserControl.Styles>
        <Style Selector="RadioButton#PaneButton">
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="RadioButton#PaneButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppControlHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}" />
        </Style>
        <Style Selector="RadioButton#PaneButton:checked">
            <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="RadioButton#PaneButton:focus-visible /template/ Border#NavSurface">
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="RadioButton#PaneButton:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </UserControl.Styles>
    <RadioButton x:Name="PaneButton" Margin="0,0,0,6"
                 AutomationProperties.Name="{Binding Text, ElementName=Root}"
                 Command="{Binding Command, ElementName=Root}"
                 CommandParameter="{Binding CommandParameter, ElementName=Root}"
                 IsChecked="{Binding IsChecked, ElementName=Root, Mode=OneWay}">
        <RadioButton.Template>
            <ControlTemplate>
                <Border x:Name="NavSurface" Background="{TemplateBinding Background}"
                        BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="12,11">
                    <Grid ColumnDefinitions="20,*" ColumnSpacing="11">
                        <controls:AppIcon Data="{Binding IconData, ElementName=Root}" Foreground="{TemplateBinding Foreground}" />
                        <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=Root}"
                                   Foreground="{TemplateBinding Foreground}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </RadioButton.Template>
    </RadioButton>
</UserControl>
