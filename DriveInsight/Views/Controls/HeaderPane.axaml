<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DriveInsight.Views.Controls"
             xmlns:icons="using:DriveInsight.Utilities"
             x:Class="DriveInsight.Views.Controls.HeaderPane" x:Name="Root">
    <UserControl.Styles>
        <Style Selector="ToggleButton.ThemeToggle">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
        </Style>
        <Style Selector="ToggleButton.ThemeToggle:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="ToggleButton.ThemeToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppControlHoverBrush}" />
        </Style>
        <Style Selector="ToggleButton.ThemeToggle controls|AppIcon.SunIcon">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ToggleButton.ThemeToggle:checked controls|AppIcon.SunIcon">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="ToggleButton.ThemeToggle:checked controls|AppIcon.MoonIcon">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>
    <Border Background="{DynamicResource AppHeaderBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20" MinHeight="34">
            <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppPrimaryTextBrush}" VerticalAlignment="Center" />
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                <ContentControl Content="{Binding CenterContent, ElementName=Root}" />
            </ScrollViewer>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ContentControl Content="{Binding RightContent, ElementName=Root}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding UpdateStatus, ElementName=Root}" IsVisible="{Binding ShowUpdateStatus, ElementName=Root}"
                           Foreground="{DynamicResource AppSecondaryTextBrush}" FontSize="11" MaxWidth="140"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding UpdateStatus, ElementName=Root}" VerticalAlignment="Center" />
                <Button Classes="IconButton" IsVisible="{Binding ShowUpdateButton, ElementName=Root}"
                        ToolTip.Tip="{Binding UpdateToolTip, ElementName=Root}" AutomationProperties.Name="{Binding UpdateToolTip, ElementName=Root}"
                        Command="{Binding UpdateCommand, ElementName=Root}">
                    <controls:AppIcon Data="{x:Static icons:AppIcons.Download}" Foreground="{DynamicResource AppAccentBrush}" />
                </Button>
                <ToggleButton Classes="ThemeToggle" IsChecked="{Binding IsDarkMode, ElementName=Root, Mode=TwoWay}"
                              ToolTip.Tip="Toggle light or dark mode" AutomationProperties.Name="Dark mode">
                    <Grid>
                        <controls:AppIcon Classes="SunIcon" Data="{x:Static icons:AppIcons.Sun}" />
                        <controls:AppIcon Classes="MoonIcon" Data="{x:Static icons:AppIcons.Moon}" />
                    </Grid>
                </ToggleButton>
                <Button Classes="IconButton" IsVisible="{Binding ShowExportButton, ElementName=Root}"
                        ToolTip.Tip="{Binding ExportToolTip, ElementName=Root}" AutomationProperties.Name="{Binding ExportToolTip, ElementName=Root}"
                        Command="{Binding ExportCommand, ElementName=Root}">
                    <controls:AppIcon Data="{x:Static icons:AppIcons.Export}" />
                </Button>
                <Button Classes="IconButton" IsVisible="{Binding ShowRefreshButton, ElementName=Root}"
                        ToolTip.Tip="{Binding RefreshToolTip, ElementName=Root}" AutomationProperties.Name="{Binding RefreshToolTip, ElementName=Root}"
                        Command="{Binding RefreshCommand, ElementName=Root}">
                    <controls:AppIcon Data="{x:Static icons:AppIcons.Refresh}" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
