<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:DriveInsight.Views.Controls"
             xmlns:icons="using:DriveInsight.Utilities"
             xmlns:viewModels="using:DriveInsight.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1120"
             d:DesignHeight="760"
             x:Class="DriveInsight.Views.DashBoardPaneView">

    <UserControl.Styles>
        <Style Selector="ProgressBar.DashboardProgress">
            <Setter Property="Height" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AppProgressTrackBrush}" />
        </Style>
        <Style Selector="controls|AppIcon.InsightIcon">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="controls|AppIcon.InsightIcon.Critical">
            <Setter Property="Foreground" Value="{DynamicResource AppCriticalBrush}" />
        </Style>
        <Style Selector="controls|AppIcon.InsightIcon.Warning">
            <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}" />
        </Style>
        <Style Selector="TextBlock.CapacityValue">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="TextBlock.CapacityValue.Warning">
            <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}" />
        </Style>
        <Style Selector="TextBlock.CapacityValue.Critical">
            <Setter Property="Foreground" Value="{DynamicResource AppCriticalBrush}" />
        </Style>
        <Style Selector="ProgressBar.DashboardProgress.Warning">
            <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}" />
        </Style>
        <Style Selector="ProgressBar.DashboardProgress.Critical">
            <Setter Property="Foreground" Value="{DynamicResource AppCriticalBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*"
          RowSpacing="0"
          Margin="0">
        <controls:HeaderPane Grid.Row="0"
                             Title="Dashboard"
                             ShowExportButton="True"
                             ExportToolTip="Export CSV"
                             ExportCommand="{Binding ExportCsvCommand}"
                             ShowRefreshButton="True"
                             RefreshToolTip="Refresh"
                             RefreshCommand="{Binding RefreshDashboardCommand}"
                             ShowUpdateButton="{Binding IsUpdateAvailable}"
                             UpdateCommand="{Binding UpdateClientCommand}"
                             UpdateStatus="{Binding UpdateStatus}"
                             ShowUpdateStatus="{Binding HasUpdateStatus}" />

        <ScrollViewer Grid.Row="1"
                      Margin="24,24,24,24"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">
                <Grid ColumnDefinitions="2.2*,1*"
                      ColumnSpacing="16">
                    <Border Classes="SectionCard"
                            VerticalAlignment="Top">
                        <StackPanel Spacing="18">
                            <TextBlock Text="System capacity"
                                       Foreground="{DynamicResource AppAccentBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold" />

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Bottom"
                                        Spacing="10">
                                <TextBlock Text="{Binding TotalUsedText}"
                                           FontSize="44"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppStrongTextBrush}" />
                                <TextBlock Text="USED"
                                           Margin="0,24,0,0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
                                <TextBlock Text="/"
                                           Margin="0,20,0,0"
                                           FontSize="22"
                                           Foreground="{DynamicResource AppMutedTextBrush}" />
                                <TextBlock Text="{Binding TotalCapacityText}"
                                           Margin="0,16,0,0"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppPrimaryTextBrush}" />
                                <TextBlock Text="TOTAL"
                                           Margin="0,25,0,0"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource AppMutedTextBrush}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10">
                                <TextBlock Text="Total utilization"
                                           Foreground="{DynamicResource AppSecondaryTextBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TotalUtilizationText}"
                                           Foreground="{DynamicResource AppAccentBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                            </Grid>

                            <ProgressBar Classes="DashboardProgress"
                                         Value="{Binding TotalUtilizationPercent}"
                                         Maximum="100" />
                        </StackPanel>
                    </Border>

                    <ItemsControl Grid.Column="1"
                                  ItemsSource="{Binding DriveBreakdowns}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="viewModels:DriveCapacityCardViewModel">
                                <Border Classes="SectionCard"
                                        Padding="14">
                                    <StackPanel Spacing="9">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="8">
                                            <TextBlock Text="{Binding DriveName}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppPrimaryTextBrush}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PercentageText}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Classes="CapacityValue" Classes.Warning="{Binding IsWarning}" Classes.Critical="{Binding IsCritical}" />
                                        </Grid>

                                        <ProgressBar Classes="DashboardProgress"
                                                     Classes.Warning="{Binding IsWarning}" Classes.Critical="{Binding IsCritical}"
                                                     Value="{Binding UsedPercent}"
                                                     Maximum="100" />

                                        <TextBlock Text="{Binding UsageText}"
                                                   Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Grid ColumnDefinitions="1.45*,1*"
                      ColumnSpacing="18">
                    <Border Classes="SectionCard"
                            Grid.Column="0">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10">
                                <TextBlock Text="Largest items"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppPrimaryTextBrush}" />
                            </Grid>

                            <TextBlock Text="{Binding LargestFilesScanStatus}"
                                       IsVisible="{Binding IsLoadingLargestFiles}"
                                       Foreground="{DynamicResource AppSecondaryTextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />

                            <ItemsControl ItemsSource="{Binding LargestFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="viewModels:LargestFileViewModel">
                                        <Border Background="{DynamicResource AppSubtleCardBackgroundBrush}"
                                                CornerRadius="7"
                                                Padding="12"
                                                Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                  ColumnSpacing="10">
                                                <Border Width="34"
                                                        Height="34"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource AppBadgeBackgroundBrush}">
                                                    <controls:AppIcon Data="{x:Static icons:AppIcons.File}" Foreground="{DynamicResource AppSecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1"
                                                            Spacing="2">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppPrimaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding FilePath}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            HorizontalAlignment="Right"
                                                            Spacing="2">
                                                    <TextBlock Text="{Binding SizeText}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppPrimaryTextBrush}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding Category}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppAccentBrush}"
                                                               HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="SectionCard"
                            Grid.Column="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Smart insights"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppPrimaryTextBrush}" />

                            <ItemsControl ItemsSource="{Binding SmartInsights}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="viewModels:InsightCardViewModel">
                                        <Border Background="{DynamicResource AppCardBackgroundBrush}"
                                                BorderBrush="{DynamicResource AppSoftBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="12"
                                                Margin="0,0,0,8">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <controls:AppIcon Classes="InsightIcon" Classes.Critical="{Binding IsCritical}" Classes.Warning="{Binding IsWarning}" Data="{Binding IconPathData}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding Title}"
                                                               Foreground="{DynamicResource AppPrimaryTextBrush}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </Grid>
                                                <TextBlock Text="{Binding Message}"
                                                           Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="10">
                                                    <Button Classes="TextAction" Content="{Binding ActionText}"
                                                            Command="{Binding ActionCommand}"
                                                            HorizontalAlignment="Left"
                                                            HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center"
                                                            Padding="10,5"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="{DynamicResource AppAccentBrush}"
                                                            FontSize="12"
                                                            FontWeight="SemiBold" />
                                                    <Button Classes="TextAction" Content="Ignore"
                                                            Command="{Binding DismissCommand}"
                                                            HorizontalAlignment="Left"
                                                            HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center"
                                                            Padding="10,5"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="{DynamicResource AppMutedTextBrush}"
                                                            FontSize="12"
                                                            FontWeight="SemiBold" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
