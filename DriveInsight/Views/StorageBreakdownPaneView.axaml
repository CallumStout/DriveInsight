<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:paneControls="using:DriveInsight.Views.Controls"
             xmlns:viewModels="using:DriveInsight.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="760"
             x:Class="DriveInsight.Views.StorageBreakdownPaneView">

    <Grid RowDefinitions="Auto,*"
          RowSpacing="0">
        <paneControls:HeaderPane Grid.Row="0"
                                 Title="Storage breakdown"
                                 ShowExportButton="True"
                                 ExportToolTip="Export CSV"
                                 ExportCommand="{Binding ExportCsvCommand}"
                                 ShowRefreshButton="True"
                                 RefreshToolTip="Rescan storage"
                                 RefreshCommand="{Binding RefreshStorageBreakdownCommand}">
            <paneControls:HeaderPane.CenterContent>
                <ListBox Classes="DriveTabs" x:Name="StorageDriveTabs"
                         ItemsSource="{Binding Drives}"
                         SelectedItem="{Binding SelectedDrive}"
                         Padding="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name, StringFormat=Drive {0}}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </paneControls:HeaderPane.CenterContent>
            <paneControls:HeaderPane.RightContent>
                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" MaxWidth="150" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" Foreground="{DynamicResource AppSecondaryTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalScannedText}"
                               IsVisible="{Binding HasBreakdown}"
                               Foreground="{DynamicResource AppPrimaryTextBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </paneControls:HeaderPane.RightContent>
        </paneControls:HeaderPane>

        <Grid Grid.Row="1"
              Margin="24,24,24,24"
              ColumnDefinitions="1.8*,1*"
              ColumnSpacing="18">
            <Border Grid.Column="0"
                    Classes="StoragePanel">
                <Viewbox Stretch="Uniform" MaxWidth="600" MaxHeight="600">
                    <Grid Width="600" Height="600">
                        <lvc:PieChart Width="560"
                                      Height="560"
                                      ZIndex="2"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Series="{Binding Series}"
                                      AnimationsSpeed="0:0:0"
                                      InitialRotation="-90"
                                      TooltipPosition="Top"
                                      MaxAngle="360"
                                      MinValue="0" />

                        <Border Width="180"
                                Height="180"
                                ZIndex="1"
                                IsHitTestVisible="False"
                                CornerRadius="90"
                                Background="{DynamicResource AppChartCenterBrush}"
                                BorderBrush="{DynamicResource AppChartCenterBorderBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="4">
                                <TextBlock Text="{Binding TotalScannedText}"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppPrimaryTextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="TOTAL SHOWN"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Scanning storage..."
                                   IsVisible="{Binding IsScanning}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,12"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                    </Grid>
                </Viewbox>
            </Border>

            <Border Grid.Column="1"
                    Classes="StoragePanel">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Breakdown"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppPrimaryTextBrush}" />
                        <TextBlock Text="Grouped by the largest top-level folders found on the selected drive."
                                   FontSize="12"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="18" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding BreakdownItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="viewModels:StorageBreakdownItemViewModel">
                                    <Border Background="{DynamicResource AppCardBackgroundBrush}"
                                            CornerRadius="10"
                                            Padding="12">
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="10">
                                            <Border Width="12"
                                                    Height="12"
                                                    CornerRadius="6"
                                                    Background="{Binding Color}"
                                                    VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1"
                                                        Spacing="2">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppPrimaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding FullPath}"
                                                           IsVisible="{Binding HasPath}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding PercentText}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppMutedTextBrush}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SizeText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppPrimaryTextBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
